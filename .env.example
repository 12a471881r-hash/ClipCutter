# Database Supabase Postgres.
# Usa la connection string "pooled" (porta 6543). db.ts rimuove sslmode/supa
# dall'URL e forza ssl:{rejectUnauthorized:false}.
DATABASE_URL=postgres://postgres:password@host:6543/postgres
# In alternativa a DATABASE_URL (letta se DATABASE_URL manca).
POSTGRES_URL=

# Supabase (DB + storage delle clip renderizzate)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Storage S3-compatibile per i video sorgente (aggira il limite 50 MB di
# Supabase free). Se non configurato, l'upload ripiega su Supabase.
#
# Backblaze B2 (nessuna carta richiesta, 10 GB gratis):
#   S3_ENDPOINT        = https://s3.us-west-004.backblazeb2.com
#   S3_REGION          = us-west-004
#   S3_PUBLIC_BASE_URL = https://f004.backblazeb2.com/file/<nome-bucket>
# Cloudflare R2 (richiede una carta anche per il piano gratuito):
#   S3_ENDPOINT        = https://<account_id>.r2.cloudflarestorage.com
#   S3_REGION          = auto
#   S3_PUBLIC_BASE_URL = https://pub-xxxx.r2.dev
S3_ENDPOINT=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=clipcutter-videos
S3_PUBLIC_BASE_URL=

# Limite upload lato client in MB (default 50, il massimo di Supabase free).
# Con lo storage S3 puoi alzarlo (es. 500).
NEXT_PUBLIC_MAX_UPLOAD_MB=

# Trascrizione
ASSEMBLYAI_API_KEY=
# Opzionale: "nano" per trascrizioni più veloci (meno accurate).
# Vuoto = modello "best".
ASSEMBLYAI_SPEECH_MODEL=

# Analisi AI (Gemini free tier)
GEMINI_API_KEY=

# Fallback analisi AI, gratuito e opzionale: usato solo se Gemini è
# sovraccarico su tutti i modelli. Chiave da https://console.groq.com
GROQ_API_KEY=
