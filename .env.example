# Database Supabase Postgres.
# Usa la connection string "pooled" (porta 6543). db.ts rimuove sslmode/supa
# dall'URL e forza ssl:{rejectUnauthorized:false}.
DATABASE_URL=postgres://postgres:password@host:6543/postgres
# In alternativa a DATABASE_URL (letta se DATABASE_URL manca).
POSTGRES_URL=

# Supabase (DB + storage delle clip renderizzate)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Cloudflare R2: storage dei video sorgente (aggira il limite 50 MB di
# Supabase free). Se non configurato, l'upload ripiega su Supabase.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=clipcutter-videos
# URL pubblico del bucket (dominio r2.dev o custom), senza slash finale
R2_PUBLIC_BASE_URL=https://pub-xxxxxxxx.r2.dev

# Limite upload lato client in MB (default 50, il massimo di Supabase free).
# Con R2 puoi alzarlo (es. 500).
NEXT_PUBLIC_MAX_UPLOAD_MB=

# Trascrizione
ASSEMBLYAI_API_KEY=
# Opzionale: "nano" per trascrizioni più veloci (meno accurate).
# Vuoto = modello "best".
ASSEMBLYAI_SPEECH_MODEL=

# Analisi AI (Gemini free tier)
GEMINI_API_KEY=

# Fallback analisi AI, gratuito e opzionale: usato solo se Gemini è
# sovraccarico su tutti i modelli. Chiave da https://console.groq.com
GROQ_API_KEY=
